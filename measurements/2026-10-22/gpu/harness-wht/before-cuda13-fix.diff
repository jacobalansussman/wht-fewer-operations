   printf("# wht_cuda on %s, sm_%d%d, %d SMs, %.0f MHz, %d-bit bus, L2 %d KB\n", p.name, p.major, p.minor,
-         p.multiProcessorCount, p.clockRate / 1e3, p.memoryBusWidth, p.l2CacheSize / 1024);
