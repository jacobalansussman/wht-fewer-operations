# Pins of the iCE40-HX8K breakout board used by the self-test (package CT256).
# Source: Lattice iCE40HX-8K Breakout Board User Guide FPGA-EB-02031-1.2, schematics on pages 13 to 16.
set_io clk     J3    # 12 MHz oscillator X1 through R20, net iCE_CLK (p. 13, p. 15)
set_io led[0]  B5    # LED0, lights D9 (p. 14, p. 16)
set_io led[1]  B4    # LED1, D8
set_io led[2]  A2    # LED2, D7
set_io led[3]  A1    # LED3, D6
set_io led[4]  C5    # LED4, D5
set_io led[5]  C4    # LED5, D4
set_io led[6]  B3    # LED6, D3
set_io led[7]  C3    # LED7, D2
set_io uart_tx B12   # RS232_Tx_TTL, to FT2232H BDBUS1 = channel B receive (p. 13, p. 14)
# Not used and not driven: B10 (RS232_Rx_TTL, driven by the FT2232H), and every other pin.
